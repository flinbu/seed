{
  "name": "@flinbu/seed",
  "version": "0.4.0",
  "description": "Seed's React components: accessible (Radix), styled with Tailwind CSS v4 and Seed tokens, themeable with createTheme.",
  "license": "MIT",
  "author": "Felipe Linares <felipe@flinbu.co>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flinbu/seed.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "design-system",
    "tailwindcss",
    "radix-ui",
    "components",
    "seed"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./compiled.css": "./dist/compiled.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@flinbu/seed-tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "@types/node": "^22.10.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://seed-lyart.vercel.app"
}
