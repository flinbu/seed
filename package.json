{
  "name": "seed-monorepo",
  "private": true,
  "description": "Seed: a calm, neutral-first design system for React and Tailwind CSS.",
  "license": "MIT",
  "author": "Felipe Linares <felipe@flinbu.co>",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --filter './packages/*' test",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "docs": "pnpm --filter docs dev",
    "build:docs": "pnpm --filter docs build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "typescript": "^5.9.3"
  }
}
